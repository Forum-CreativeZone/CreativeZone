{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assets-forum",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash"
  },
  "observability": {
    "enabled": true
  }
}