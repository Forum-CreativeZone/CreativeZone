{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "assets-forum",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "drop-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "forum.creativezone.pro",
      "custom_domain": true
    },
    {
      "pattern": "creativezone.pro/cz-20261010-7f4b9c2e6a1d8f305c92b4e7a613d8f4.txt",
      "zone_name": "creativezone.pro"
    },
    {
      "pattern": "www.creativezone.pro/cz-20261010-7f4b9c2e6a1d8f305c92b4e7a613d8f4.txt",
      "zone_name": "creativezone.pro"
    }
  ],
  "main": "worker.js"
}
